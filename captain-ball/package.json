{
  "name": "captain-ball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Captain Ball - a 2.5D isometric sports game built with Phaser 3.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
